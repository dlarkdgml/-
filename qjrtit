<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>윤건 클리커</title>
<style>
:root{--gold:#ffd76a;--ink:#172033;--panel:rgba(12,20,37,.82);--line:rgba(255,255,255,.14)}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;color:#fff;font-family:system-ui,-apple-system,"Noto Sans KR",sans-serif;background:#101b2d url("background.jpg") center/cover fixed no-repeat}
body:before{content:"";position:fixed;inset:0;background:linear-gradient(135deg,rgba(5,13,28,.68),rgba(7,23,42,.45));z-index:-1}
button{font:inherit;cursor:pointer}
.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;padding:12px clamp(14px,3vw,38px);gap:12px}
.brand{font-size:clamp(21px,3vw,30px);font-weight:950;letter-spacing:-1.2px;text-shadow:0 3px 18px #000}
.brand span{color:var(--gold)}
.top-actions{display:flex;align-items:center;gap:10px}
.coin-box,.nav-btn{border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(12px);border-radius:15px;padding:10px 15px;box-shadow:0 8px 30px #0003}
.coin-box{font-weight:850;color:var(--gold);min-width:130px;text-align:center}
.nav-btn{color:#fff;font-weight:800}
.nav-btn:hover,.buy-btn:hover{filter:brightness(1.12);transform:translateY(-1px)}
.main{width:min(1240px,94vw);margin:18px auto 40px;display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:22px;align-items:stretch}
.play-area,.upgrade-panel{background:var(--panel);border:1px solid var(--line);border-radius:26px;backdrop-filter:blur(14px);box-shadow:0 18px 55px #0005}
.play-area{min-height:610px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px 20px;position:relative;overflow:hidden}
.play-area:after{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(255,215,106,.13),transparent 68%);pointer-events:none}
.stat-label{font-size:14px;color:#c7d2e5;font-weight:700}
.click-count{font-size:clamp(26px,4vw,42px);font-weight:950;color:#fff;text-shadow:0 4px 18px #0008;margin:5px 0 20px}
.character-wrap{position:relative;z-index:1;width:min( min(390px,72vw), 390px);aspect-ratio:1;display:grid;place-items:center}
.character{width:100%;height:100%;border-radius:28px;object-fit:contain;user-select:none;-webkit-user-drag:none;filter:drop-shadow(0 18px 24px #0008);transition:transform .08s;cursor:pointer}
.character:active,.character.pop{transform:scale(.94) rotate(-1deg)}
.placeholder{width:78%;height:78%;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;background:linear-gradient(145deg,#405a7d,#18283f);border:3px dashed rgba(255,255,255,.3);color:#dce8fa;font-weight:850;font-size:20px;line-height:1.6;box-shadow:inset 0 0 50px #0004,0 20px 40px #0005;cursor:pointer}
.hint{margin-top:18px;color:#b8c5d9;font-size:14px}
.power{margin-top:7px;font-size:14px;color:var(--gold);font-weight:800}
.upgrade-panel{padding:22px;display:flex;flex-direction:column;gap:14px}
.panel-title{font-size:22px;font-weight:950;margin:0 0 2px}
.panel-sub{font-size:13px;color:#aebbd0;margin:0 0 4px}
.upgrade-card{border:1px solid var(--line);background:rgba(255,255,255,.055);border-radius:18px;padding:16px}
.upgrade-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
.upgrade-name{font-weight:900;font-size:17px}
.level{font-size:12px;color:#c6d1e2;background:#ffffff16;border-radius:99px;padding:5px 9px}
.description{font-size:13px;color:#b9c6d9;margin:8px 0 13px;line-height:1.5}
.buy-row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.price{font-weight:900;color:var(--gold);font-size:14px}
.buy-btn{border:0;border-radius:11px;background:linear-gradient(135deg,#ffe18b,#f6ae38);color:#34230a;font-weight:950;padding:10px 14px;min-width:92px;transition:.15s}
.buy-btn:disabled{opacity:.38;cursor:not-allowed;filter:grayscale(.6);transform:none}
.side-note{font-size:12px;color:#91a0b8;line-height:1.55;margin-top:auto;padding-top:5px}
.float{position:absolute;z-index:5;pointer-events:none;font-weight:950;color:#ffe17d;text-shadow:0 2px 8px #000;animation:float .8s ease-out forwards}
@keyframes float{0%{opacity:0;transform:translateY(10px) scale(.8)}20%{opacity:1}100%{opacity:0;transform:translateY(-65px) scale(1.15)}}
.screen{position:fixed;inset:0;background:rgba(4,9,19,.82);backdrop-filter:blur(12px);z-index:20;display:none;align-items:center;justify-content:center;padding:18px}
.screen.open{display:flex}
.modal{width:min(560px,100%);max-height:85vh;overflow:auto;background:#111d32;border:1px solid var(--line);border-radius:24px;padding:24px;box-shadow:0 24px 80px #0009}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.modal h2{margin:0;font-size:25px}
.close{border:1px solid var(--line);background:#ffffff12;color:#fff;border-radius:10px;padding:8px 12px;font-weight:800}
.rank-row{display:grid;grid-template-columns:48px 1fr auto;align-items:center;gap:10px;padding:13px 8px;border-bottom:1px solid #ffffff12}
.rank-num{font-weight:950;color:var(--gold);font-size:18px}
.rank-name{font-weight:800}.rank-count{font-size:13px;color:#c4d0e2}
.notice{font-size:12px;color:#9eacc2;line-height:1.6;margin-top:15px;padding:12px;background:#ffffff09;border-radius:12px}
@media(max-width:760px){
 .topbar{height:auto;padding:13px 14px;flex-wrap:wrap}
 .brand{font-size:22px}.top-actions{gap:7px}.coin-box,.nav-btn{padding:9px 11px;font-size:13px}
 .main{grid-template-columns:1fr;width:min(94vw,560px);margin:8px auto 28px;gap:14px}
 .play-area{min-height:430px;padding:24px 14px}
 .character-wrap{width:min(72vw,310px)}
 .upgrade-panel{padding:18px}
 .panel-title{font-size:20px}
}
@media(max-width:380px){.brand{font-size:19px}.coin-box{min-width:105px}.play-area{min-height:390px}}

.auth-screen{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(3,8,18,.88);backdrop-filter:blur(14px)}
.auth-card{width:min(430px,100%);background:#111d32;border:1px solid var(--line);border-radius:24px;padding:26px;box-shadow:0 24px 80px #0009}
.auth-card h1{margin:0 0 6px;font-size:28px}.auth-card p{color:#aebbd0;font-size:13px;line-height:1.6;margin:0 0 18px}
.auth-field{display:block;margin:12px 0 6px;font-size:13px;color:#d5deeb;font-weight:800}
.auth-input{width:100%;border:1px solid #ffffff24;background:#ffffff0c;color:#fff;border-radius:11px;padding:12px 13px;font:inherit;outline:none}
.auth-input:focus{border-color:var(--gold)}.auth-input option{color:#172033}
.auth-submit{width:100%;margin-top:16px;border:0;border-radius:12px;padding:13px;background:linear-gradient(135deg,#ffe18b,#f6ae38);color:#34230a;font-weight:950}
.auth-switch{width:100%;margin-top:10px;border:1px solid var(--line);border-radius:12px;padding:11px;background:#ffffff0c;color:#fff;font-weight:800}
.auth-message{min-height:20px;margin-top:12px;color:#ffd76a;font-size:13px;line-height:1.5}
.auth-hidden{display:none!important}
.user-chip{border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:9px 12px;font-size:12px;color:#dce6f5}
.logout-btn{border:1px solid var(--line);background:#ffffff12;color:#fff;border-radius:10px;padding:9px 11px;font-weight:800}
@media(max-width:760px){.auth-card{padding:22px}.user-chip{display:none}}

</style>
</head>
<body>

<div class="auth-screen" id="authScreen">
  <div class="auth-card">
    <h1>윤건 <span style="color:var(--gold)">클리커</span></h1>
    <p id="authIntro">오션벳에서 사용하던 아이디와 비밀번호로 로그인하세요.</p>
    <div id="loginFields">
      <label class="auth-field" for="loginUid">아이디</label>
      <input class="auth-input" id="loginUid" autocomplete="username" placeholder="예: 20101">
      <label class="auth-field" for="loginPassword">비밀번호</label>
      <input class="auth-input" id="loginPassword" type="password" autocomplete="current-password" placeholder="비밀번호">
      <button class="auth-submit" id="loginBtn">로그인</button>
      <button class="auth-switch" id="showSignup">처음이라면 회원가입</button>
    </div>
    <div id="signupFields" class="auth-hidden">
      <label class="auth-field" for="signupUid">아이디</label>
      <input class="auth-input" id="signupUid" placeholder="오션벳 아이디 형식 (예: 20101)">
      <label class="auth-field" for="signupPassword">비밀번호</label>
      <input class="auth-input" id="signupPassword" type="password" autocomplete="new-password" placeholder="비밀번호 6자 이상">
      <label class="auth-field" for="signupPassword2">비밀번호 확인</label>
      <input class="auth-input" id="signupPassword2" type="password" autocomplete="new-password" placeholder="비밀번호 다시 입력">
      <label class="auth-field" for="signupQuestion">보안 질문</label>
      <input class="auth-input" id="signupQuestion" placeholder="예: 내가 좋아하는 색은?">
      <label class="auth-field" for="signupAnswer">보안 답변</label>
      <input class="auth-input" id="signupAnswer" placeholder="보안 답변">
      <button class="auth-submit" id="signupBtn">회원가입</button>
      <button class="auth-switch" id="showLogin">로그인으로 돌아가기</button>
    </div>
    <div class="auth-message" id="authMessage"></div>
  </div>
</div>

<header class="topbar">
  <button class="nav-btn" id="rankBtn">🏆 랭킹</button>
  <div class="brand">윤건 <span>클리커</span></div>
  <div class="top-actions">
    <div class="coin-box">🪙 <span id="coins">0</span></div><div class="user-chip" id="userChip"></div><button class="logout-btn" id="logoutBtn">로그아웃</button>
  </div>
</header>

<main class="main">
  <section class="play-area" id="playArea">
    <div class="stat-label">내 누적 클릭 횟수</div>
    <div class="click-count" id="clickCount">0회</div>
    <div class="character-wrap" id="characterWrap">
      <!-- 나중에 character.png 파일을 넣으면 아래 이미지가 표시됩니다. -->
      <div class="placeholder" id="placeholder">여기에<br>캐릭터 사진을<br>넣어주세요</div>
      <img class="character" id="character" src="character.png" alt="클릭할 캐릭터" hidden>
    </div>
    <div class="hint">캐릭터를 클릭해서 코인을 모아보세요!</div>
    <div class="power" id="powerText">클릭당 🪙 1 코인</div>
  </section>

  <aside class="upgrade-panel">
    <div>
      <h2 class="panel-title">⚡ 강화 상점</h2>
      <p class="panel-sub">코인을 사용해 더 빠르게 성장하세요.</p>
    </div>
    <article class="upgrade-card">
      <div class="upgrade-head"><div class="upgrade-name">👆 클릭 강화</div><div class="level" id="clickLevel">Lv. 0</div></div>
      <p class="description">캐릭터를 한 번 클릭할 때 얻는 코인이 증가합니다.</p>
      <div class="buy-row"><div class="price" id="clickPrice">🪙 50</div><button class="buy-btn" id="buyClick">강화하기</button></div>
    </article>
    <article class="upgrade-card">
      <div class="upgrade-head"><div class="upgrade-name">🤖 자동 클릭</div><div class="level" id="autoLevel">Lv. 0</div></div>
      <p class="description">접속 중 자동으로 코인을 획득합니다. 자동 클릭은 랭킹 클릭 수에 포함되지 않습니다.</p>
      <div class="buy-row"><div class="price" id="autoPrice">🪙 120</div><button class="buy-btn" id="buyAuto">강화하기</button></div>
    </article>
    <div class="side-note">게임 기록은 현재 이 브라우저에 저장됩니다. 브라우저 데이터 삭제나 기기 변경 시 기록이 사라질 수 있습니다.</div>
  </aside>
</main>

<div class="screen" id="rankScreen">
  <div class="modal">
    <div class="modal-head"><h2>🏆 전체 랭킹</h2><button class="close" id="closeRank">닫기</button></div>
    <div id="rankList"></div>
    <div class="notice">전체 회원의 누적 직접 클릭 횟수 기준 랭킹입니다. 자동 클릭 횟수는 랭킹에서 제외됩니다.</div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>

// 1) 아래 두 값을 오션벳과 같은 Supabase 프로젝트의 Project URL / anon public key로 채우세요.
const SB_URL = "SUPABASE_PROJECT_URL을_여기에_입력";
const SB_ANON_KEY = "SUPABASE_ANON_PUBLIC_KEY를_여기에_입력";

const $ = id => document.getElementById(id);
const clientReady = window.supabase && SB_URL.startsWith("https://") && SB_ANON_KEY.length > 20;
let sb = clientReady ? window.supabase.createClient(SB_URL, SB_ANON_KEY) : null;
let user = null;
let state = {coins:0, clicks:0, clickLevel:0, autoLevel:0, nickname:""};
let autoTimer = null;
const clickCosts = [50,120,250,500,950,1700,3000,5200,9000,15000];
const autoCosts  = [120,260,550,1100,2200,4300,8200,15000,27000,48000];
const costAt = (arr, level) => arr[level] ?? Math.floor(arr[arr.length-1] * Math.pow(1.65, level-arr.length+1));
const clickPower = () => 1 + state.clickLevel;
const fmt = n => Math.floor(Number(n)||0).toLocaleString("ko-KR");

function authMessage(msg, error=false){
  $("authMessage").textContent = msg;
  $("authMessage").style.color = error ? "#ff9b9b" : "#ffd76a";
}
function showLogin(){
  $("loginFields").classList.remove("auth-hidden");
  $("signupFields").classList.add("auth-hidden");
  $("authIntro").textContent="오션벳에서 사용하던 아이디와 비밀번호로 로그인하세요.";
  authMessage("");
}
function showSignup(){
  $("loginFields").classList.add("auth-hidden");
  $("signupFields").classList.remove("auth-hidden");
  $("authIntro").textContent="오션벳과 같은 Supabase 프로젝트에 새 계정을 만듭니다.";
  authMessage("");
}
function emailFromUid(uid){ return uid.trim().toLowerCase() + "@ocean.game"; }

function render(){
  $("coins").textContent=fmt(state.coins);
  $("clickCount").textContent=fmt(state.clicks)+"회";
  $("powerText").textContent="클릭당 🪙 "+fmt(clickPower())+" 코인"+(state.autoLevel>0?" · 자동 초당 "+state.autoLevel+" 코인":"");
  $("clickLevel").textContent="Lv. "+state.clickLevel;
  $("autoLevel").textContent="Lv. "+state.autoLevel;
  const cp=costAt(clickCosts,state.clickLevel), ap=costAt(autoCosts,state.autoLevel);
  $("clickPrice").textContent="🪙 "+fmt(cp);
  $("autoPrice").textContent="🪙 "+fmt(ap);
  $("buyClick").disabled=state.coins<cp;
  $("buyAuto").disabled=state.coins<ap;
}
function showGame(){
  $("authScreen").classList.add("auth-hidden");
  $("userChip").textContent="회원 "+(user?.uid || "");
  $("logoutBtn").classList.remove("auth-hidden");
  render();
  startAutoTicker();
}
function hideGame(){
  $("authScreen").classList.remove("auth-hidden");
  $("logoutBtn").classList.add("auth-hidden");
  if(autoTimer) clearInterval(autoTimer);
}
async function loadState(){
  // 서버 RPC가 최초 기록을 생성하고 본인 기록만 반환합니다.
  const {data,error}=await sb.rpc("clicker_get_state");
  if(error) throw error;
  state={coins:Number(data.coins),clicks:Number(data.clicks),clickLevel:data.click_level,autoLevel:data.auto_level,nickname:user.uid};
  render();
}
async function afterAuth(sessionUser){
  user=sessionUser;
  const {data:profile,error:profileError}=await sb.from("profiles")
    .select("uid,banned").eq("id",user.id).single();
  if(profileError) throw new Error("오션벳 회원 정보를 확인할 수 없습니다: "+profileError.message);
  if(profile.banned) { await sb.auth.signOut(); throw new Error("이 계정은 이용이 제한되어 있습니다."); }
  user.uid=profile.uid;
  await loadState();
  showGame();
}
async function login(){
  if(!sb){authMessage("Supabase URL과 anon public key를 먼저 입력해야 합니다.",true);return;}
  const uid=$("loginUid").value.trim(), password=$("loginPassword").value;
  if(!uid||!password){authMessage("아이디와 비밀번호를 입력하세요.",true);return;}
  $("loginBtn").disabled=true;
  try{
    const {data,error}=await sb.auth.signInWithPassword({email:emailFromUid(uid),password});
    if(error) throw error;
    await afterAuth(data.user);
  }catch(e){authMessage("로그인 실패: "+e.message,true);}
  finally{$("loginBtn").disabled=false;}
}
async function signup(){
  if(!sb){authMessage("Supabase URL과 anon public key를 먼저 입력해야 합니다.",true);return;}
  const uid=$("signupUid").value.trim(), pw=$("signupPassword").value, pw2=$("signupPassword2").value;
  const sq=$("signupQuestion").value.trim(), sa=$("signupAnswer").value.trim();
  if(!/^20[1-7](0[1-9]|1[0-9]|20)$/.test(uid) && uid!=="lgh0221"){
    authMessage("오션벳에서 사용하는 아이디 형식이 아닙니다.",true);return;
  }
  if(pw.length<6){authMessage("비밀번호는 6자 이상 입력하세요.",true);return;}
  if(pw!==pw2){authMessage("비밀번호가 서로 다릅니다.",true);return;}
  if(!sq||!sa){authMessage("보안 질문과 답변을 입력하세요.",true);return;}
  $("signupBtn").disabled=true;
  try{
    const {data,error}=await sb.auth.signUp({
      email:emailFromUid(uid),password:pw,
      options:{data:{sq,sa}}
    });
    if(error) throw error;
    if(data.session){await afterAuth(data.user);}
    else{authMessage("가입 요청이 완료됐지만 세션이 없습니다. Supabase Auth의 이메일 확인 설정을 확인하세요.");}
  }catch(e){authMessage("회원가입 실패: "+e.message,true);}
  finally{$("signupBtn").disabled=false;}
}
async function logout(){
  if(autoTimer) clearInterval(autoTimer);
  await sb.auth.signOut();
  user=null; state={coins:0,clicks:0,clickLevel:0,autoLevel:0,nickname:""};
  hideGame(); showLogin();
}
function showLogin(){ 
  $("loginFields").classList.remove("auth-hidden");
  $("signupFields").classList.add("auth-hidden");
  $("authIntro").textContent="오션벳에서 사용하던 아이디와 비밀번호로 로그인하세요.";
  authMessage("");
}
async function earnClick(e){
  if(!user) return;
  const area=$("playArea"), rect=area.getBoundingClientRect();
  const x=e&&e.clientX?e.clientX-rect.left:rect.width/2;
  const y=e&&e.clientY?e.clientY-rect.top:rect.height/2;
  try{
    const {data,error}=await sb.rpc("clicker_click");
    if(error) throw error;
    state.coins=Number(data.coins); state.clicks=Number(data.clicks);
    const img=$("character");
    if(!img.hidden){img.classList.remove("pop");void img.offsetWidth;img.classList.add("pop");}
    const f=document.createElement("div");f.className="float";f.textContent="+"+fmt(data.earned)+" 🪙";f.style.left=x+"px";f.style.top=y+"px";area.appendChild(f);setTimeout(()=>f.remove(),850);
    render();
  }catch(err){console.error(err);authMessage("클릭 저장 오류: "+err.message,true);}
}
async function buyUpgrade(kind){
  try{
    const {data,error}=await sb.rpc("clicker_buy_upgrade",{p_kind:kind});
    if(error) throw error;
    state.coins=Number(data.coins);state.clickLevel=data.click_level;state.autoLevel=data.auto_level;render();
  }catch(e){alert(e.message.includes("insufficient")?"코인이 부족합니다.":("강화 실패: "+e.message));}
}
async function tickAuto(){
  if(!user || state.autoLevel<=0) return;
  try{
    const {data,error}=await sb.rpc("clicker_auto_tick");
    if(error) throw error;
    state.coins=Number(data.coins);render();
  }catch(e){console.warn("자동 코인 동기화 실패",e.message);}
}
function startAutoTicker(){
  if(autoTimer) clearInterval(autoTimer);
  autoTimer=setInterval(tickAuto,1000);
}
async function loadLeaderboard(){
  $("rankList").innerHTML='<div class="notice">랭킹 불러오는 중...</div>';
  try{
    const {data,error}=await sb.rpc("clicker_leaderboard");
    if(error) throw error;
    if(!data || !data.length){$("rankList").innerHTML='<div class="notice">아직 랭킹 기록이 없습니다.</div>';return;}
    $("rankList").innerHTML=data.map((r,i)=>`<div class="rank-row"><div class="rank-num">${i+1}</div><div class="rank-name">${escapeHtml(r.uid)}${r.uid===user.uid?' (나)':''}</div><div class="rank-count">${fmt(r.clicks)} 클릭</div></div>`).join("");
  }catch(e){$("rankList").innerHTML='<div class="notice">랭킹을 불러오지 못했습니다: '+escapeHtml(e.message)+'</div>';}
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}

